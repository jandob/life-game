title: ChartR1Viewing
tags: chart
---
// The story chart of route 1 (see src/story/chart.rs). Chart nodes are data and never
// run: read by the chart checks, start points and dialogue_graph.
//   <<chapter ID "CARD">>             one per node, in story order
//   <<gate ID "LABEL" REQUIRES...>>    $gate_ID, true once done; needs the gates listed
//   <<bottleneck ID "LABEL" REQUIRES...>> the gate that ends the chapter
// $chapter names the current chapter. It is set only by the chapter's start node.
<<declare $chapter = "">>
<<declare $gate_r1_view_knock = false>>
<<declare $gate_r1_view_window = false>>
<<declare $gate_r1_view_kitchen = false>>
<<declare $gate_r1_view_bath = false>>
<<declare $gate_r1_view_end = false>>
<<chapter R1Viewing "Saturday. The viewing.">>
<<gate r1_view_knock "Knock on 3B: she shows him in">>
<<gate r1_view_window "Look at the window" r1_view_knock>>
<<gate r1_view_kitchen "Look at the kitchenette" r1_view_knock>>
<<gate r1_view_bath "Look at the bathroom" r1_view_knock>>
<<bottleneck r1_view_end "Tell her he's seen enough" r1_view_window r1_view_kitchen r1_view_bath>>
===
