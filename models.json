{
  "_comment": "Model registry for the diffusers backends. 'hf' = [repo, file] in the Hugging Face cache, a plain path is a local file (read-only, never copied); '~' is expanded. Set ARTGEN_MODELS=/other/models.json to use another file.",
  "z_image_turbo": {
    "transformer": "~/ComfyUI-Shared/models/diffusion_models/z_image_turbo_bf16.safetensors",
    "text_encoder": "~/ComfyUI-Shared/models/text_encoders/qwen_3_4b.safetensors",
    "vae": "~/ComfyUI-Shared/models/vae/ae.safetensors",
    "config_repo": "Tongyi-MAI/Z-Image-Turbo",
    "tokenizer_repo": "Tongyi-MAI/Z-Image"
  },
  "qwen_image21": {
    "gguf_repo": "abenzerps/Qwen-Image-2.1-Turbo-Quantized",
    "gguf_file": "qwen-image-2.1-turbo-Q8_0.gguf",
    "config_repo": "Qwen/Qwen-Image-2.1-Turbo"
  },
  "runpod_qwen_image21": {
    "model": "Qwen/Qwen-Image-2.1",
    "endpoint_env": "ARTGEN_RUNPOD_ENDPOINT",
    "worker": "rp_handler.py + remote/runpod/Dockerfile (endpoint model cache: Qwen/Qwen-Image-2.1)",
    "timeout_s": 1800,
    "defaults": {
      "steps": 40,
      "true_cfg": 4.0,
      "negative": "low quality, blurry, deformed, text, watermark"
    }
  }
}
